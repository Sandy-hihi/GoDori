rules_version = '2';

// ─────────────────────────────────────────────────────────────
// 고도리(GoDori) Firestore 보안 규칙 (2단계: Firebase Authentication 적용)
//
// 누가 무엇을 할 수 있나
//   - 손님 패드: 앱이 켜질 때 익명 로그인 → 게임·메뉴·설정 읽기, 주문·직원 호출 "생성"만 가능
//   - 관리자: 서버 함수(/api/auth/login)가 PIN/비밀번호를 확인한 뒤 발급한 토큰으로 로그인
//            → 토큰에 admin: true 표시가 있어서 isAdmin() 통과
//            (태블릿 '관리자 대시보드' = admin-pad, 관리자 웹 = admin-web)
//   - 로그인하지 않은 요청: 공개 정보(게임·메뉴·설정) 읽기만 가능
//
// settings/adminPin 은 서버만 읽음 (앱·브라우저에서 읽기 불가). 수정은 Firebase 콘솔에서.
// settings/storeInfo 는 콘솔 전용 (콘솔은 보안 규칙을 거치지 않음)
// _authLimits 등 위에 없는 컬렉션은 전부 차단 (서버의 로그인 실패 기록 등)
//
// 배포: "BoardPad 배포.bat" → 5번 (또는 firebase deploy --only firestore:rules)
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // 방 번호 검사: 관리자 웹 '매장 설정'에서 정한 settings/rooms 의 count 이하 (문서가 없으면 11개)
    function roomOk(n) {
      let roomsPath = /databases/$(database)/documents/settings/rooms;
      return n is int && n >= 1
          && ((!exists(roomsPath) && n <= 11)
              || (exists(roomsPath) && n <= get(roomsPath).data.count));
    }


    // ── 주문 ──
    match /orders/{orderId} {
      // 주문 목록은 관리자 주문현황에서만 봄
      allow read: if isAdmin();

      // 손님 태블릿의 주문 생성 (food_order_screen.dart) — 로그인(익명)한 패드만
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(
                         ['room', 'time', 'price', 'items', 'notes', 'roomColor', 'status', 'timestamp'])
                    && request.resource.data.room is string
                    && request.resource.data.room.matches('#[1-9][0-9]?')                 // #1 ~ #99 형식
                    && roomOk(int(request.resource.data.room.replace('#', '')))   // 매장 설정의 방 개수 이하
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 100
                    && request.resource.data.price is string
                    && request.resource.data.price.size() <= 10
                    && request.resource.data.notes is string
                    && request.resource.data.notes.size() <= 300
                    && request.resource.data.status == 'pending'
                    && request.resource.data.timestamp == request.time;

      // 관리자 주문현황: 상태(status)만 변경 가능
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['pending', 'preparing', 'completed'];

      // 관리자 주문현황: '완료'된 주문만 삭제 가능
      allow delete: if isAdmin() && resource.data.status == 'completed';
    }

    // ── 직원 호출 ──
    match /staff_calls/{callId} {
      allow read: if isAdmin();

      // 손님 태블릿의 호출 생성 (staff_call_service.dart) — 로그인(익명)한 패드만
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['roomNumber', 'timestamp', 'isAcknowledged'])
                    && request.resource.data.roomNumber is int
                    && (request.resource.data.roomNumber == 0 || roomOk(request.resource.data.roomNumber))
                    && request.resource.data.isAcknowledged == false
                    && request.resource.data.timestamp == request.time;

      // 관리자의 '확인' 처리만 허용
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isAcknowledged'])
                    && request.resource.data.isAcknowledged == true;

      allow delete: if false;
    }

    // ── 보드게임 / 메뉴 ── 누구나 보기, 관리자만 수정
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /menus/{menuId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 설정 문서 ──
    match /settings/{docId} {
      // 관리자 PIN/비밀번호 문서는 아무도 못 읽음 (서버 함수만 Admin SDK로 읽음)
      allow read: if docId != 'adminPin';
      // 관리자 페이지가 수정하는 문서만, 관리자만 쓰기 허용. adminPin / storeInfo는 콘솔 전용.
      allow write: if isAdmin()
                   && docId in ['genres', 'categories', 'events', 'notices', 'appRefresh', 'homeLayout'];
      // 방 개수 (관리자 웹 '매장 설정'): 1 ~ 30 사이 숫자만
      allow write: if isAdmin()
                   && docId == 'rooms'
                   && request.resource.data.keys().hasOnly(['count', 'updatedAt'])
                   && request.resource.data.count is int
                   && request.resource.data.count >= 1
                   && request.resource.data.count <= 30;
    }

    // 위에 없는 컬렉션은 기본적으로 모두 차단됩니다.
  }
}
