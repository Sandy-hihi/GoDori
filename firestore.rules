rules_version = '2';

// ─────────────────────────────────────────────────────────────
// BoardPad Firestore 보안 규칙 (1단계: 현재 앱 구조 그대로 적용 가능)
//
// 현재 앱은 Firebase Authentication을 쓰지 않아서, 규칙에서
// "손님 태블릿"과 "관리자"를 구별할 수 없습니다.
// 그래서 이 단계에서는
//   1) 앱이 쓰지 않는 컬렉션/문서는 전부 차단하고
//   2) 손님이 만드는 데이터(주문, 직원 호출)의 형식을 엄격히 검사하고
//   3) 수정·삭제는 앱이 실제로 하는 동작만 허용합니다.
// games / menus / settings 쓰기 보호는 2단계(Firebase Auth 도입)에서 강화합니다.
//
// settings/adminPin, settings/storeInfo 는 Firebase 콘솔에서만 수정
// (콘솔은 보안 규칙을 거치지 않으므로 계속 수정 가능)
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 주문 ──
    match /orders/{orderId} {
      allow read: if true;

      // 손님 태블릿의 주문 생성 (food_order_screen.dart)
      allow create: if request.resource.data.keys().hasOnly(
                         ['room', 'time', 'price', 'items', 'notes', 'roomColor', 'status', 'timestamp'])
                    && request.resource.data.room is string
                    && request.resource.data.room.matches('#([1-9]|1[01])')   // #1 ~ #11 방
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 100
                    && request.resource.data.price is string
                    && request.resource.data.price.size() <= 10
                    && request.resource.data.notes is string
                    && request.resource.data.notes.size() <= 300
                    && request.resource.data.status == 'pending'
                    && request.resource.data.timestamp == request.time;

      // 관리자 주문현황: 상태(status)만 변경 가능
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['pending', 'preparing', 'completed'];

      // 관리자 주문현황: '완료'된 주문만 삭제 가능
      allow delete: if resource.data.status == 'completed';
    }

    // ── 직원 호출 ──
    match /staff_calls/{callId} {
      allow read: if true;

      // 손님 태블릿의 호출 생성 (staff_call_service.dart)
      allow create: if request.resource.data.keys().hasOnly(['roomNumber', 'timestamp', 'isAcknowledged'])
                    && request.resource.data.roomNumber is int
                    && request.resource.data.roomNumber >= 0
                    && request.resource.data.roomNumber <= 11
                    && request.resource.data.isAcknowledged == false
                    && request.resource.data.timestamp == request.time;

      // 관리자의 '확인' 처리만 허용
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isAcknowledged'])
                    && request.resource.data.isAcknowledged == true;

      allow delete: if false;
    }

    // ── 보드게임 / 메뉴 ── (2단계에서 관리자만 쓰기 가능하도록 변경)
    match /games/{gameId} {
      allow read: if true;
      allow write: if true;
    }
    match /menus/{menuId} {
      allow read: if true;
      allow write: if true;
    }

    // ── 설정 문서 ──
    match /settings/{docId} {
      // adminPin은 현재 앱이 PIN 확인을 위해 읽어야 해서 읽기를 막을 수 없음 (2단계에서 해결)
      allow read: if true;
      // 관리자 페이지가 수정하는 문서만 쓰기 허용. adminPin / storeInfo는 콘솔 전용.
      allow write: if docId in ['genres', 'categories', 'events', 'notices', 'appRefresh', 'homeLayout'];
    }

    // 위에 없는 컬렉션은 기본적으로 모두 차단됩니다.
  }
}
